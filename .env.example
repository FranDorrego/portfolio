# La direccion publica del sitio, sin barra final. Va en canonica, Open Graph y sitemap.
# En GitHub Pages la pone sola la accion (.github/workflows/sitio.yml).
VITE_SITE_URL=

# La API del panel /admin/ (admin-api/), sin barra final. Por defecto, https://api.francodorrego.com.
VITE_ADMIN_API=
